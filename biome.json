{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/*.md",
			"!**/*.svg",
			"!packages/db/migrations",
			"!apps/web/src/routeTree.gen.ts"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				"noDefaultExport": "error",
				"noProcessEnv": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/*/src/features/**",
				"apps/*/src/lib/**",
				"apps/*/src/components/**",
				"apps/api/src/http/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#features/*", "#features/**"],
										"message": "Only app.ts (API) and routes/ (web) import features; inside a feature, import its own files by relative path. Move shared code to lib/, or pass it in from the route."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.config.ts"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/components/ui/label.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/api/src/config/load.ts",
				"apps/web/vite.config.ts",
				"e2e/playwright.config.ts",
				"packages/db/drizzle.config.ts",
				"packages/db/src/testing/database.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		}
	]
}
