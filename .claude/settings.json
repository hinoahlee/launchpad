{
	"permissions": {
		"deny": ["Read(./**/.env)"],
		"ask": [
			"Bash(gh pr merge:*)",
			"Bash(gh repo create:*)",
			"Bash(pnpm dlx:*)",
			"Bash(pnpm add:*)",
			"Bash(pnpm --filter * add *)"
		],
		"allow": [
			"Bash(pnpm:*)",
			"Bash(git:*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr view:*)",
			"Bash(gh run:*)",
			"Bash(docker:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm -C \"$CLAUDE_PROJECT_DIR\" exec biome check --write . >&2 || exit 2",
						"timeout": 60
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "grep -q '\"stop_hook_active\": *true' && exit 0; pnpm -C \"$CLAUDE_PROJECT_DIR\" verify >&2 || exit 2",
						"timeout": 300
					}
				]
			}
		]
	}
}
