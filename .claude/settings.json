{
	"permissions": {
		"deny": ["Read(./**/.env)", "Read(./**/*.secret.tfvars)"],
		"ask": [
			"Bash(terraform apply:*)",
			"Bash(terraform destroy:*)",
			"Bash(terraform import:*)",
			"Bash(terraform state:*)",
			"Bash(aws:*)",
			"Bash(gh pr merge:*)",
			"Bash(gh repo create:*)",
			"Bash(pnpm dlx:*)"
		],
		"allow": [
			"Bash(pnpm:*)",
			"Bash(git:*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr view:*)",
			"Bash(gh run:*)",
			"Bash(docker:*)",
			"Bash(terraform fmt:*)",
			"Bash(terraform validate:*)",
			"Bash(terraform plan:*)",
			"Bash(terraform init:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "pnpm exec biome check --write . >&2 || exit 2",
						"timeout": 60
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "grep -q '\"stop_hook_active\": *true' && exit 0; pnpm verify >&2 || exit 2",
						"timeout": 300
					}
				]
			}
		]
	}
}
