{
	"permissions": {
		"deny": ["Read(./**/.env)"],
		"ask": [
			"Bash(gh pr merge:*)",
			"Bash(gh repo create:*)",
			"Bash(pnpm dlx:*)",
			"Bash(pnpm add:*)",
			"Bash(pnpm --filter * add *)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)"
		],
		"allow": [
			"Bash(pnpm:*)",
			"Bash(git:*)",
			"Bash(node scripts/*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh run:*)",
			"Bash(docker:*)",
			"Bash(cat:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(grep:*)",
			"Bash(ls:*)",
			"Bash(wc:*)",
			"Bash(echo:*)",
			"Edit(/apps/**)",
			"Edit(/packages/**)",
			"Edit(/e2e/**)",
			"Edit(/docs/**)",
			"Edit(/.agentic/**)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/format-hook.ts\"",
						"timeout": 60
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/stop-gate.ts\" --reset",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/stop-gate.ts\"",
						"timeout": 1200
					}
				]
			}
		]
	}
}
