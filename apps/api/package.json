{
	"name": "@launchpad/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"dev": "node --watch-path=src --env-file-if-exists=.env src/server.ts",
		"dev:worker": "tsx watch --clear-screen=false --env-file-if-exists=.env src/worker.ts",
		"build": "tsdown",
		"start": "node --enable-source-maps dist/server.js",
		"typecheck": "tsc",
		"test": "vitest run",
		"db:migrate": "node --env-file-if-exists=.env src/migrate.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "catalog:",
		"@fastify/compress": "catalog:",
		"@fastify/helmet": "catalog:",
		"@fastify/rate-limit": "catalog:",
		"@fastify/static": "catalog:",
		"@launchpad/db": "workspace:*",
		"@launchpad/shared": "workspace:*",
		"@sentry/node": "catalog:",
		"better-auth": "catalog:",
		"croner": "catalog:",
		"drizzle-orm": "catalog:",
		"fastify": "catalog:",
		"fastify-type-provider-zod": "catalog:",
		"pino": "catalog:",
		"postgres": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@launchpad/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
