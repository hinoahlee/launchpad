{
	"name": "@launchpad/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"dev": "node --watch-path=src --env-file-if-exists=.env src/server.ts",
		"build": "tsdown",
		"start": "node --enable-source-maps dist/server.js",
		"typecheck": "tsc",
		"test": "vitest run"
	},
	"dependencies": {
		"@fastify/static": "catalog:",
		"fastify": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@launchpad/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
