# API settings for `pnpm dev`. Copy to `apps/api/.env` (git-ignored) and edit. Never put production secrets here.
# Shell variables (`PORT=4000 pnpm dev`) don't reach the apps: Turborepo filters them. Set them here instead.
NODE_ENV=development
# The web dev proxy targets 3000; change both together.
PORT=3000
LOG_LEVEL=info
# GIT_SHA is set by the image build; leave it unset locally (defaults to "dev").
# Local Postgres from compose.dev.yml (`pnpm db:up`). Dev-only password.
DATABASE_URL=postgres://launchpad:launchpad@localhost:5433/launchpad
# Only when DATABASE_URL goes through a transaction-mode pooler: a direct URL for the worker and migrations.
# Not supported as is: a pooler also needs `prepare: false` in packages/db/src/client.ts.
DATABASE_DIRECT_URL=
# Error tracking (Sentry project launchpad-api → Client Keys). Leave empty locally: dev errors stay out of Sentry.
SENTRY_DSN=
# The environment tag on Sentry errors; defaults to NODE_ENV. Set it where that isn't the whole story (staging).
# SENTRY_ENVIRONMENT=
# Set to true for GET /api/debug/error, a route that throws (checks reporting end to end). Leave off.
DEBUG_ERROR_ROUTE=false
# Proxies in front of the app that append to X-Forwarded-For. 0 locally (no proxy); Render sets 2.
TRUST_PROXY_HOPS=0
# Email through Resend (worker only). Both set: real emails; both empty: the worker only logs them.
# Key: Resend → API Keys, "Sending access", limited to the sending domain. Use a key of its own for local dev.
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret of a Resend webhook ("whsec_..."): turns on POST /api/webhooks/resend (server only). Resend can't
# reach localhost, so this usually stays empty in dev; tests sign their own requests.
RESEND_WEBHOOK_SECRET=
# Auth (Better Auth). The public origin; empty: Vite's http://localhost:5173, which proxies /api here.
APP_URL=
# Signs session cookies. Empty: a fixed dev-only value. Production needs its own: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google sign-in (Google Cloud → Google Auth Platform → Clients → launchpad-web). Both set, or both empty (no
# Google button). The secret is a secret: here and in Render's dashboard only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# File storage (server and worker), README "Optional services" → "Files". Bucket set: uploads on; empty: off.
# Keys: both or neither (neither on AWS, where the instance or task role provides them).
# Use a dev bucket and its own key here, never production's.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto. AWS S3: endpoint empty, region e.g. us-east-1.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Billing (Stripe, server only). Both set: billing on; both empty: off. From the Stripe sandbox, never live mode here.
# Key: Developers → API keys → a restricted key ("rk_test_..."); price: Product catalog → the product → its price.
STRIPE_API_KEY=
STRIPE_PRICE_ID=
# Turns on POST /api/webhooks/stripe. Stripe can't reach localhost: run
#   stripe listen --project-name launchpad --forward-to localhost:3000/api/webhooks/stripe --events "checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed,invoice.paid,invoice.payment_failed"
# (one line; the events are the SYNC_EVENTS in apps/api/src/features/billing/webhook/constants.ts, and the quotes
# matter: unquoted, PowerShell passes a,b,c as "a b c", one invalid event, and nothing is forwarded)
# and paste the "whsec_..." it prints (the same each time for that device). Empty: no webhook; the page still syncs
# when you come back from Stripe.
STRIPE_WEBHOOK_SECRET=
