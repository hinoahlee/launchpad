{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			// ^test: a package's tests wait for its dependencies' tests (api waits for db). Both use the one test
			// database and wipe it, so they must not run at the same time.
			"dependsOn": ["^build", "^test"],
			"passThroughEnv": ["TEST_DATABASE_URL"]
		},
		// Builds the API and the web app first (e2e lists both as dependencies), then drives them in a browser.
		// Never cached: it also depends on the database and the browser, which turbo can't see.
		"e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		// Offline: schema.ts vs. the committed migrations. Reruns only when these inputs change.
		"db:check": {
			"inputs": [
				"src/schema.ts",
				"migrations/**",
				"scripts/check-migrations.ts"
			],
			"outputs": []
		}
	}
}
