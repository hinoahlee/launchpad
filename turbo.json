{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			// ^test: packages share one test database, so their tests must not run at the same time.
			"dependsOn": ["^build", "^test"],
			"passThroughEnv": ["TEST_DATABASE_URL"]
		},
		// Never cached: it depends on the database and the browser, which turbo can't see.
		"e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:worker": {
			"cache": false,
			"persistent": true
		},
		"db:check": {
			"inputs": [
				"src/schema/**",
				"migrations/**",
				"scripts/check-migrations.ts"
			],
			"outputs": []
		}
	}
}
