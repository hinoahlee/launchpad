# Dependencies
node_modules/

# Build output
dist/
build/
coverage/

# Playwright output (reports, traces, failure screenshots)
e2e/playwright-report/
e2e/test-results/

# Tool caches
.turbo/
.vite/

# Env files hold secrets; only the example is committed
.env
.env.*
!.env.example

# Terraform state and secret vars
*.tfstate
*.tfstate.*
.terraform/
*.secret.tfvars

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Personal Claude Code settings (the shared ones are .claude/settings.json)
.claude/settings.local.json

# The global gitignore on this machine hides these; this repo commits them on purpose
!CLAUDE.md
!.claude/

# drizzle-kit scratch output from `pnpm db:check`
.migrations-check/

# Database dumps. Real data: never commit.
.drill/

# Agent run state, specs, reviews and run records (/feature, /deliver): local to this machine. Not `.workflow/`:
# that name marks a wf-kit project, whose global guard blocks git push.
.agentic/
