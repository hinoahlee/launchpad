{
	"name": "launchpad",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24.0.0 <25",
		"pnpm": ">=12.21.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
