{
	"name": "launchpad",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24.0.0 <25",
		"pnpm": ">=12.21.0"
	},
	"scripts": {
		"dev": "turbo run dev dev:worker",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "biome check . && node scripts/check-file-size.ts && node scripts/check-imports.ts",
		"format": "biome check --write .",
		"test": "turbo run test",
		"e2e": "turbo run e2e",
		"verify": "pnpm lint && turbo run typecheck test build db:check",
		"db:up": "docker compose -f compose.dev.yml up -d --wait",
		"db:down": "docker compose -f compose.dev.yml down",
		"db:generate": "pnpm --filter @launchpad/db db:generate",
		"db:migrate": "pnpm --filter @launchpad/api db:migrate",
		"db:check": "pnpm --filter @launchpad/db db:check",
		"db:studio": "pnpm --filter @launchpad/db db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
